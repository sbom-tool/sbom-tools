              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-MACHINE-READABLE",
              "name": "CraMachineReadableFormat",
              "shortDescription": {
                "text": "CRA Annex I Part II (1): SBOM must be in a commonly used, machine-readable format (CycloneDX 1.4+, SPDX 2.3+, or SPDX 3.0+)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
