{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "sbom-tools",
          "version": "[VERSION]",
          "informationUri": "https://github.com/sbom-tool/sbom-tools",
          "rules": [
            {
              "id": "SBOM-CRA-SBOM-FRESHNESS",
              "name": "CraSbomFreshness",
              "shortDescription": {
                "text": "CRA Art. 13(7) / Annex I Part II (1): SBOM freshness — timely regeneration after changes"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-MACHINE-READABLE",
              "name": "CraMachineReadableFormat",
              "shortDescription": {
                "text": "CRA Annex I Part II (1): SBOM must be in a commonly used, machine-readable format (CycloneDX 1.4+, SPDX 2.3+, or SPDX 3.0+)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-ART-13-17-CONTACT",
              "name": "CraVulnerabilityContact",
              "shortDescription": {
                "text": "CRA Art. 13(17): Single point of contact for vulnerability reporting (Annex I Part II (6), Annex II (2))"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-VULN-METADATA",
              "name": "CraVulnerabilityMetadata",
              "shortDescription": {
                "text": "CRA Annex I Part II (4): Vulnerability entries carry a severity or CVSS score"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-VULN-METADATA-REMEDIATION",
              "name": "CraVulnerabilityRemediationDetail",
              "shortDescription": {
                "text": "CRA Annex I Part II (4): Vulnerability remediations name a fixed version or describe the fix"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-VULN-METADATA-PROFILE",
              "name": "CraSecurityProfileConformance",
              "shortDescription": {
                "text": "CRA Annex I Part II (4): SPDX 3.0 Security profile declared for a document that carries vulnerabilities"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-ART-13-5",
              "name": "CraLicensedComponentTracking",
              "shortDescription": {
                "text": "CRA Art. 13(5): Third-party due diligence — license information for all components"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-ART-13-5-PROFILE",
              "name": "CraLicensingProfileConformance",
              "shortDescription": {
                "text": "CRA Art. 13(5): SPDX 3.0 SimpleLicensing profile declared for a document that carries license data"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-CVD-POLICY",
              "name": "CraCoordinatedDisclosure",
              "shortDescription": {
                "text": "CRA Annex I Part II (5): Coordinated vulnerability disclosure policy reference"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-ART-13-8",
              "name": "CraSupportPeriod",
              "shortDescription": {
                "text": "CRA Art. 13(8) / 13(19): Support period and security update end date (Annex II (7))"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-ART-13-8-EOL",
              "name": "CraEndOfLifeComponents",
              "shortDescription": {
                "text": "CRA Art. 13(8): Components past end-of-life, which receive no more security updates"
