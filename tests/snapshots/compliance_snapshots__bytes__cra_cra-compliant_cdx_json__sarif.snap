                "level": "error"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-ANNEX-I-TRACEABILITY",
              "name": "CraPrimaryTraceability",
              "shortDescription": {
                "text": "CRA Annex I Part II (1): Primary product component traceable across updates by a PURL or CPE"
