              {
                "observation-uuid": "8e3f6f16-3644-5e2e-b415-927935a992e5"
              }
            ],
            "remarks": "Declare the BSI/G7 SBOM-for-AI minimum elements: document author, data-format name + version, timestamp, generation tool, and signature; the primary AI system, its producer, and its data-flow/usage; runtime/framework infrastructure links; and AI-specific security controls / exploitability references where they can be expressed. CycloneDX: sign the BOM: in JSON, a JSF signature object (algorithm and value) at the document root; in XML, an enveloped XML-DSig \\<Signature\\> element on \\<bom\\>.",
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-bsiai-meta-signature",
              "type": "objective-id"
            },
