              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "id": "SBOM-CRA-PRE-8-RQ-02",
              "name": "CraHardwareInventory",
              "shortDescription": {
                "text": "CRA prEN 40000-1-3 [PRE-8-RQ-02]: Hardware components must be inventoried with producer, name, identifier, and firmware version"
