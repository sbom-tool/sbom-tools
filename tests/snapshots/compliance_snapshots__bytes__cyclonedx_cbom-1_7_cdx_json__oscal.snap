          },
          {
            "description": "'SLH-DSA-SHAKE-256s' uses SLH-DSA, which is NIST-approved (FIPS 205) but not part of CNSA 2.0",
            "related-observations": [
              {
                "observation-uuid": "8aab58b5-d0ed-558f-89f5-f07778197876"
              }
            ],
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-cnsa2-alg-008",
              "type": "objective-id"
            },
            "title": "SBOM-CNSA2-ALG-008",
            "uuid": "4d902b2a-1026-56fd-8fc6-fcf54144c217"
          },
          {
            "description": "'X25519' (ECDH) is quantum-vulnerable, must migrate to CNSA 2.0 approved algorithm",
            "related-observations": [
              {
                "observation-uuid": "219f2c5c-b79e-5624-9643-b8ee672b6215"
              }
            ],
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-cnsa2-alg-006",
              "type": "objective-id"
            },
            "title": "SBOM-CNSA2-ALG-006",
            "uuid": "28868e81-aeef-5565-b716-f6b8a3b55435"
          },
          {
            "description": "'X25519-ML-KEM-768' quantum level 3 < 5, CNSA 2.0 requires Level 5",
            "related-observations": [
              {
                "observation-uuid": "62d42cf7-a0cd-53f5-b203-d8fefb9de912"
              }
            ],
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-cnsa2-alg-007",
              "type": "objective-id"
            },
            "title": "SBOM-CNSA2-ALG-007",
            "uuid": "0a09665e-98df-5e36-a44a-13c01f1dc1c6"
          },
          {
            "description": "'X25519-ML-KEM-768' uses the hybrid X25519 + ML-KEM-768, which CNSA 2.0 does not approve: ML-KEM-768 is not ML-KEM-1024, and X25519 is not a CNSA 1.0 algorithm (ECDH or ECDSA over P-384, or RSA or DH of 3072 bits or more)",
            "related-observations": [
              {
                "observation-uuid": "d5952ed0-0744-562c-9b87-525951bf3312"
              }
            ],
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-cnsa2-alg-003",
              "type": "objective-id"
            },
            "title": "SBOM-CNSA2-ALG-003",
            "uuid": "b540a580-74da-586e-95d1-6df5c4f6d2ec"
          },
          {
            "description": "'ECDSA-P521' (ECDSA) is quantum-vulnerable, must migrate to CNSA 2.0 approved algorithm",
            "related-observations": [
              {
                "observation-uuid": "b0c49624-58db-592f-84a7-a42f91e1afb2"
              }
            ],
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-cnsa2-alg-006",
              "type": "objective-id"
            },
            "title": "SBOM-CNSA2-ALG-006",
            "uuid": "42a3c7dd-4f3a-5628-9d21-295b6836e27f"
          },
          {
            "description": "Protocol 'TLS 1.3 (PQC Hybrid)' cipher suite 'TLS_AES_256_GCM_SHA384_ML_KEM_768' includes non-CNSA 2.0 algorithms: X25519 + ML-KEM-768, ML-KEM-768",
            "related-observations": [
              {
                "observation-uuid": "7ecac478-b7bd-5bcd-ba3a-f37a718bcf42"
              }
            ],
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-cnsa2-proto-002",
              "type": "objective-id"
            },
            "title": "SBOM-CNSA2-PROTO-002",
            "uuid": "bca247cf-f493-544c-ae48-7342f02db0fb"
          },
          {
            "description": "Protocol 'TLS 1.3 (PQC Hybrid)' cipher suite 'TLS_AES_256_GCM_SHA384' includes non-CNSA 2.0 algorithms: ECDH",
            "related-observations": [
