                "value": "pqc|SBOM-PQC-001|crypto/algorithm/x25519"
              }
            ],
            "related-observations": [
              {
                "observation-uuid": "b9bd0bc0-1f4e-5c73-8293-365130ae28a9"
              }
            ],
            "remarks": "Migrate quantum-vulnerable algorithms per NIST IR 8547 (Transition to Post-Quantum Cryptography Standards): adopt ML-KEM (FIPS 203), ML-DSA (FIPS 204), SLH-DSA (FIPS 205) or SP 800-208 stateful hash-based signatures, and retire algorithms disallowed by SP 800-131A Rev. 2.",
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-pqc-001",
              "type": "objective-id"
