            },
            "title": "NIST PQC Readiness compliance roll-up",
            "uuid": "561d4f28-70fb-5ac8-8227-b4571cf1d096"
          },
          {
            "description": "'X25519' (ECDH) is quantum-vulnerable and must migrate to PQC (IR 8547)",
            "links": [
              {
                "href": "https://csrc.nist.gov/projects/post-quantum-cryptography",
                "rel": "help"
              }
            ],
            "props": [
              {
                "name": "finding-id",
                "ns": "https://sbom.tools/ns/oscal",
                "value": "sbomtools:v1:9f9263b04c514a5f"
              },
              {
