  "runs": [
    {
      "tool": {
        "driver": {
          "name": "sbom-tools",
          "version": "[VERSION]",
          "informationUri": "https://github.com/sbom-tool/sbom-tools",
          "rules": [
            {
              "id": "SBOM-CNSA2-000",
              "name": "Cnsa2CryptoInventory",
              "shortDescription": {
                "text": "CNSA 2.0: cryptographic inventory (CBOM) with evaluable assets required — compliance cannot be verified without one"
              },
              "fullDescription": {
                "text": "CNSA 2.0: cryptographic inventory (CBOM) with evaluable assets required — compliance cannot be verified without one. References: CNSA 2.0."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://media.defense.gov/2022/Sep/07/2003071834/-1/-1/0/CSA_CNSA_2.0_ALGORITHMS_.PDF",
              "help": {
                "text": "Migrate to the CNSA 2.0 suite: AES-256, SHA-384/SHA-512, ML-KEM-1024, ML-DSA-87, or SP 800-208 stateful hash-based signatures (LMS/XMSS/HSS); use TLS 1.3 for network protocols. Unclassifiable algorithms cannot be verified — declare an algorithmFamily, OID, or recognizable name.\n\nReferences:\n- CNSA 2.0 (https://media.defense.gov/2022/Sep/07/2003071834/-1/-1/0/CSA_CNSA_2.0_ALGORITHMS_.PDF)",
                "markdown": "Migrate to the CNSA 2.0 suite: AES-256, SHA-384/SHA-512, ML-KEM-1024, ML-DSA-87, or SP 800-208 stateful hash-based signatures (LMS/XMSS/HSS); use TLS 1.3 for network protocols. Unclassifiable algorithms cannot be verified — declare an algorithmFamily, OID, or recognizable name.\n\n**References**\n\n- [CNSA 2.0](<https://media.defense.gov/2022/Sep/07/2003071834/-1/-1/0/CSA_CNSA_2.0_ALGORITHMS_.PDF>)"
              }
            },
            {
              "id": "SBOM-CNSA2-ALG-001",
              "name": "Cnsa2SymmetricAlgorithm",
