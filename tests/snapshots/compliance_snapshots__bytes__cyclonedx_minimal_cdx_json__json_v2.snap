        {
          "finding_id": "sbomtools:v1:8b7cd2c62a51b687",
          "finding_key": "ntia|SBOM-NTIA-DEPENDENCY|test-app",
          "severity": "Warning",
          "category": "DependencyInfo",
          "message": "Primary component 'test-app' participates in no dependency relationship",
          "element": "test-app",
          "component_id": "test-app",
          "requirement": "NTIA: Dependency relationships",
          "rule_id": "SBOM-NTIA-DEPENDENCY",
          "sarif_rule_id": "SBOM-NTIA-DEPENDENCY",
          "standard_refs": [
            {
              "standard": "NtiaMinimum",
              "id": "NTIA Minimum Elements",
              "help_uri": "https://www.ntia.gov/report/2021/minimum-elements-software-bill-materials-sbom"
            }
          ],
          "remediation": "Declare the dependency relationships between components (an NTIA minimum data field): connect the primary component to its direct dependencies and keep most components inside the dependency graph. CycloneDX: add dependencies[] entries (ref plus dependsOn[]); an entry with an empty dependsOn records a component that has no dependencies.",
          "help_uri": "https://www.ntia.gov/report/2021/minimum-elements-software-bill-materials-sbom"
        },
