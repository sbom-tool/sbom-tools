        {
          "finding_id": "sbomtools:v1:8dbbd0ee3922d90e",
          "finding_key": "ntia|SBOM-NTIA-IDENTIFIER|test-app",
          "severity": "Error",
          "category": "ComponentIdentification",
          "message": "Component 'test-app' missing unique identifier (PURL/CPE/SWHID/SWID)",
          "element": "test-app",
          "component_id": "test-app",
          "requirement": "NTIA Minimum Elements: Other Unique Identifiers",
          "rule_id": "SBOM-NTIA-IDENTIFIER",
          "sarif_rule_id": "SBOM-NTIA-IDENTIFIER",
          "standard_refs": [
            {
              "standard": "NtiaMinimum",
              "id": "NTIA Minimum Elements",
              "help_uri": "https://www.ntia.gov/report/2021/minimum-elements-software-bill-materials-sbom"
            }
          ],
          "remediation": "Give every component another unique identifier (an NTIA minimum data field): a PURL, CPE, SWHID or SWID. CycloneDX: set components[].purl (or cpe, or swhid[]).",
          "help_uri": "https://www.ntia.gov/report/2021/minimum-elements-software-bill-materials-sbom"
        },
        {
          "finding_id": "sbomtools:v1:ab835691e2f798bb",
          "finding_key": "ntia|SBOM-NTIA-SUPPLIER|test-app",
          "severity": "Error",
          "category": "SupplierInfo",
          "message": "Component 'test-app' missing supplier/manufacturer",
          "element": "test-app",
          "component_id": "test-app",
          "requirement": "NTIA: Supplier information",
          "rule_id": "SBOM-NTIA-SUPPLIER",
          "sarif_rule_id": "SBOM-NTIA-SUPPLIER",
          "standard_refs": [
            {
              "standard": "NtiaMinimum",
              "id": "NTIA Minimum Elements",
              "help_uri": "https://www.ntia.gov/report/2021/minimum-elements-software-bill-materials-sbom"
            }
          ],
          "remediation": "Name the supplier of every component, the entity that creates, defines and identifies it (an NTIA minimum data field); placeholders such as NOASSERTION do not count. CycloneDX: set components[].supplier.name (or manufacturer.name, or authors[].name).",
          "help_uri": "https://www.ntia.gov/report/2021/minimum-elements-software-bill-materials-sbom"
        },
