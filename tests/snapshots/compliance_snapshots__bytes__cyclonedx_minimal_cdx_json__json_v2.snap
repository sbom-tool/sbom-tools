        {
          "finding_id": "sbomtools:v1:17cdd69dc4e4f721",
          "finding_key": "cisa-2026|SBOM-CISA2026-COVERAGE|document",
          "severity": "Warning",
          "category": "DependencyInfo",
          "message": "[CISA 2026] Coverage: the SBOM does not declare its completeness (CycloneDX compositions aggregate); information gaps must be explicitly stated as unknown or deliberately withheld",
          "element": null,
          "requirement": "CISA 2026 Minimum Elements: Coverage / Explicitly Identifying Unknown Information",
          "rule_id": "SBOM-CISA2026-COVERAGE",
          "sarif_rule_id": "SBOM-CISA2026-COVERAGE",
          "standard_refs": [
            {
              "standard": "CisaMinimum2026",
              "id": "Coverage",
              "help_uri": "https://www.cisa.gov/resources-tools/resources/2026-minimum-elements-software-bill-materials-sbom"
            },
            {
              "standard": "CisaMinimum2026",
              "id": "Explicitly Identifying Unknown Information",
              "help_uri": "https://www.cisa.gov/resources-tools/resources/2026-minimum-elements-software-bill-materials-sbom"
            }
          ],
          "remediation": "Declare the SBOM's completeness: the 2026 Coverage element expects all components including transitive dependencies, and information gaps must be explicitly stated as unknown or deliberately withheld. This rule verifies the declaration, not actual completeness — the document itself points to external repositories / binary analysis for that. SPDX 2.x has no completeness declaration, so the rule is not evaluated for SPDX 2.x documents. CycloneDX: set compositions[].aggregate (complete, incomplete, incomplete_first_party_only, …); the first composition is read.",
          "help_uri": "https://www.cisa.gov/resources-tools/resources/2026-minimum-elements-software-bill-materials-sbom"
        }
