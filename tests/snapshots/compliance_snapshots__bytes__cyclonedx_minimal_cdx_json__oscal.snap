              {
                "observation-uuid": "a7c2bbb7-edd2-5571-af13-4733dc930a96"
              }
            ],
            "remarks": "Declare the dependency relationships between components (an NTIA minimum data field): connect the primary component to its direct dependencies and keep most components inside the dependency graph. CycloneDX: add dependencies\\[\\] entries (ref plus dependsOn\\[\\]); an entry with an empty dependsOn records a component that has no dependencies.",
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-ntia-dependency",
              "type": "objective-id"
            },
