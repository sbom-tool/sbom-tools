            "id": "§5.2.1",
            "help_uri": "https://bsi.bund.de/dok/TR-03183-en"
          }
        ],
        "remediation": "Identify the SBOM creator with an email address, or a URL (e.g. the creator's home page) if no email is available; generation tools do not count as the creator. SPDX 3.0: set creationInfo.createdBy to a Person or Organization element that has a name; createdUsing tools do not count.",
        "help_uri": "https://bsi.bund.de/dok/TR-03183-en"
      },
