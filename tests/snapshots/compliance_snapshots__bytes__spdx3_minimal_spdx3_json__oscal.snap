            "related-observations": [
              {
                "observation-uuid": "420ec616-fa81-5f79-a0e6-949df6872c8f"
              }
            ],
            "remarks": "Follow the SBOM practice of EO 14028 §4(e): use a machine-readable format (CycloneDX 1.4+, SPDX 2.2+, or SPDX 3.0+), generate the SBOM with a tool, and include unique identifiers, versions, hashes, dependencies and supplier information. This is practice, not a federal mandate: OMB M-26-05 rescinded the M-22-18 attestation requirement, though an agency may still ask for an SBOM in its contract. SPDX 3.0: set software\\_packageUrl, or add an externalIdentifier\\[\\] entry with externalIdentifierType packageUrl, cpe23, swhid or swid.",
            "target": {
              "status": {
                "state": "not-satisfied"
              },
              "target-id": "sbom-eo14028-identifier",
              "type": "objective-id"
            },
