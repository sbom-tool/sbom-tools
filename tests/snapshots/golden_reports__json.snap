            {
              "standard": "CraAnnex",
              "id": "Annex II (2)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            }
          ],
          "remediation": "Give the product a single point of contact for vulnerability reports (Art. 13(17)): a security contact or vulnerability-disclosure URL referenced from the product component. securityContact or vulnerabilityDisclosureUrl in the CRA sidecar lowers the finding to Info. CycloneDX: add a metadata.component.externalReferences[] entry of type security-contact (or advisories).",
          "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
        },
        {
          "severity": "Info",
          "category": "SecurityInfo",
          "message": "[CRA Art. 13(8) / 13(19)] Consider specifying a support end date for security updates",
          "element": null,
          "requirement": "CRA Art. 13(8) / 13(19): Support period disclosure",
          "rule_id": "SBOM-CRA-ART-13-8",
          "sarif_rule_id": "SBOM-CRA-ART-13-8",
          "standard_refs": [
            {
              "standard": "CraArticle",
              "id": "Art. 13(8)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraArticle",
              "id": "Art. 13(19)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
