        {
          "severity": "Error",
          "category": "DocumentMetadata",
          "message": "SBOM must have creator/tool information",
          "element": null,
          "requirement": "Document creator identification",
          "rule_id": "SBOM-CRA-GENERAL",
          "sarif_rule_id": "SBOM-CRA-GENERAL",
          "remediation": "Fix the document-level element the finding names. The CRA profiles' generic checks look for the SBOM's creator, a document serial number, a name on every component, a spec version sbom-tools reads (CycloneDX 1.4–1.7, SPDX 2.x or 3.0) and well-formed element identifiers. CycloneDX: set the creator (metadata.authors[], metadata.manufacturer or metadata.tools), serialNumber, components[].name, specVersion 1.4–1.7, and a bom-ref on every component."
        },
        {
          "severity": "Warning",
          "category": "DocumentMetadata",
          "message": "[CRA Art. 13(16)] SBOM should identify the manufacturer (organization)",
          "element": null,
          "requirement": "CRA Art. 13(16): Manufacturer identification",
          "rule_id": "SBOM-CRA-ART-13-16",
          "sarif_rule_id": "SBOM-CRA-ART-13-16",
          "standard_refs": [
            {
              "standard": "CraArticle",
              "id": "Art. 13(16)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraAnnex",
              "id": "Annex II (1)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            }
          ],
          "remediation": "Identify the manufacturer as an organization creator of the SBOM (Art. 13(16)); manufacturerName in the CRA sidecar lowers this to Info. CycloneDX: set metadata.manufacturer (name, contact[].email).",
          "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
        },
        {
          "severity": "Warning",
          "category": "SecurityInfo",
          "message": "[CRA Art. 13(17)] SBOM should include a security contact or vulnerability disclosure reference",
          "element": null,
          "requirement": "CRA Art. 13(17): Vulnerability disclosure contact",
          "rule_id": "SBOM-CRA-ART-13-17-CONTACT",
          "sarif_rule_id": "SBOM-CRA-ART-13-17-CONTACT",
          "standard_refs": [
            {
              "standard": "CraArticle",
              "id": "Art. 13(17)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraAnnex",
              "id": "Annex I Part II (6)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
