    "new": {
      "is_compliant": false,
      "level": "CraPhase2",
      "violations": [
        {
          "severity": "Error",
          "category": "DocumentMetadata",
          "message": "SBOM must have creator/tool information",
          "element": null,
          "requirement": "Document creator identification",
          "rule_id": "SBOM-CRA-GENERAL",
          "sarif_rule_id": "SBOM-CRA-GENERAL",
          "remediation": "Fix the document-level element the finding names. The CRA profiles' generic checks look for the SBOM's creator, a document serial number, a name on every component, a spec version sbom-tools reads (CycloneDX 1.4–1.7, SPDX 2.x or 3.0) and well-formed element identifiers. CycloneDX: set the creator (metadata.authors[], metadata.manufacturer or metadata.tools), serialNumber, components[].name, specVersion 1.4–1.7, and a bom-ref on every component."
        },
        {
          "severity": "Warning",
          "category": "DocumentMetadata",
          "message": "[CRA Art. 13(16)] SBOM should identify the manufacturer (organization)",
          "element": null,
          "requirement": "CRA Art. 13(16): Manufacturer identification",
          "rule_id": "SBOM-CRA-ART-13-16",
          "sarif_rule_id": "SBOM-CRA-ART-13-16",
          "standard_refs": [
            {
              "standard": "CraArticle",
              "id": "Art. 13(16)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraAnnex",
              "id": "Annex II (1)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            }
          ],
          "remediation": "Identify the manufacturer as an organization creator of the SBOM (Art. 13(16)); manufacturerName in the CRA sidecar lowers this to Info. CycloneDX: set metadata.manufacturer (name, contact[].email).",
          "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
        },
        {
          "severity": "Warning",
          "category": "SecurityInfo",
          "message": "[CRA Art. 13(17)] SBOM should include a security contact or vulnerability disclosure reference",
          "element": null,
          "requirement": "CRA Art. 13(17): Vulnerability disclosure contact",
          "rule_id": "SBOM-CRA-ART-13-17-CONTACT",
          "sarif_rule_id": "SBOM-CRA-ART-13-17-CONTACT",
          "standard_refs": [
            {
              "standard": "CraArticle",
              "id": "Art. 13(17)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraAnnex",
              "id": "Annex I Part II (6)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraAnnex",
              "id": "Annex II (2)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            }
          ],
          "remediation": "Give the product a single point of contact for vulnerability reports (Art. 13(17)): a security contact or vulnerability-disclosure URL referenced from the product component. securityContact or vulnerabilityDisclosureUrl in the CRA sidecar lowers the finding to Info. CycloneDX: add a metadata.component.externalReferences[] entry of type security-contact (or advisories).",
          "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
        },
        {
          "severity": "Info",
          "category": "SecurityInfo",
          "message": "[CRA Art. 13(8) / 13(19)] Consider specifying a support end date for security updates",
          "element": null,
          "requirement": "CRA Art. 13(8) / 13(19): Support period disclosure",
          "rule_id": "SBOM-CRA-ART-13-8",
          "sarif_rule_id": "SBOM-CRA-ART-13-8",
          "standard_refs": [
            {
              "standard": "CraArticle",
              "id": "Art. 13(8)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraArticle",
              "id": "Art. 13(19)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraAnnex",
              "id": "Annex II (7)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            }
          ],
          "remediation": "Declare when security updates end (Art. 13(8) / 13(19)): set supportEndDate in the CRA sidecar, or record the date in the SBOM. Components the end-of-life data marks as no longer supported need upgrading or replacing. CycloneDX: add a metadata.component.properties[] entry named end-of-support whose value is the date (RFC 3339 or YYYY-MM-DD).",
          "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
        },
        {
          "severity": "Warning",
          "category": "ComponentIdentification",
          "message": "[CRA Annex I Part II (1)] Primary component 'acme-webapp' missing unique identifier (PURL/CPE) for cross-update traceability",
          "element": "acme-webapp",
          "component_id": "acme-webapp",
          "requirement": "CRA Annex I Part II (1): Product identifier traceability across updates",
          "rule_id": "SBOM-CRA-ANNEX-I-TRACEABILITY",
          "sarif_rule_id": "SBOM-CRA-ANNEX-I",
          "standard_refs": [
            {
              "standard": "CraAnnex",
              "id": "Annex I Part II",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "Pren40000_1_3",
              "id": "PRE-7-RQ-07"
            }
          ],
          "remediation": "Give the primary product component a PURL or CPE so it can be traced across updates (Annex I Part II (1)); a SWHID or SWID alone does not satisfy this check. CycloneDX: set metadata.component.purl (or cpe).",
          "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
        },
        {
          "severity": "Warning",
          "category": "SecurityInfo",
          "message": "[CRA Annex I Part II (5)] SBOM should reference a coordinated vulnerability disclosure policy (advisories URL or disclosure URL)",
          "element": null,
          "requirement": "CRA Annex I Part II (5): Coordinated vulnerability disclosure policy",
          "rule_id": "SBOM-CRA-CVD-POLICY",
          "sarif_rule_id": "SBOM-CRA-CVD-POLICY",
          "standard_refs": [
            {
              "standard": "CraAnnex",
              "id": "Annex I Part II (5)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraArticle",
              "id": "Art. 13(8)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "Pren40000_1_3",
              "id": "RLS-2-RQ-03-RE"
            }
          ],
          "remediation": "Reference the coordinated vulnerability disclosure policy (Annex I Part II (5)) from the product component. In the CRA sidecar, coordinatedDisclosurePolicyUrl satisfies the open-source steward profile and vulnerabilityDisclosureUrl lowers the manufacturer finding to Info. CycloneDX: add a metadata.component.externalReferences[] entry of type advisories linking the policy.",
          "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
        },
        {
          "severity": "Info",
          "category": "SecurityInfo",
          "message": "[CRA Art. 13(8) / Annex II (7)] Consider including component lifecycle/end-of-support information",
          "element": null,
          "requirement": "CRA Annex II (7): Component lifecycle status",
          "rule_id": "SBOM-CRA-LIFECYCLE",
          "sarif_rule_id": "SBOM-CRA-LIFECYCLE",
          "standard_refs": [
            {
              "standard": "CraArticle",
              "id": "Art. 13(8)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            },
            {
              "standard": "CraAnnex",
              "id": "Annex II (7)",
              "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
            }
          ],
          "remediation": "Record component lifecycle or end-of-support status (Art. 13(8) / Annex II (7)); supportEndDate in the CRA sidecar counts too. Plan replacements for components approaching end-of-life. CycloneDX: add an eol, lifecycle or end-of-support entry to components[].properties[] (or an end-of-support date to metadata.component.properties[]).",
          "help_uri": "https://eur-lex.europa.eu/eli/reg/2024/2847/oj/eng"
        },
        {
