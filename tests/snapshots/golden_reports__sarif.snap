---
source: tests/golden_reports.rs
expression: "render(&SarifReporter::new())"
---
{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "[VERSION]",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "sbom-tools",
          "version": "[VERSION]",
          "informationUri": "https://github.com/binarly-io/sbom-tools",
          "rules": [
            {
              "id": "SBOM-TOOLS-001",
              "name": "ComponentAdded",
              "shortDescription": {
                "text": "A new component was added to the SBOM"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "SBOM-TOOLS-002",
              "name": "ComponentRemoved",
              "shortDescription": {
                "text": "A component was removed from the SBOM"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SBOM-TOOLS-003",
              "name": "VersionChanged",
              "shortDescription": {
                "text": "A component version was changed"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "SBOM-TOOLS-004",
              "name": "LicenseChanged",
              "shortDescription": {
                "text": "A license was added or changed"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SBOM-TOOLS-005",
              "name": "VulnerabilityIntroduced",
              "shortDescription": {
                "text": "A new vulnerability was introduced"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SBOM-TOOLS-006",
              "name": "VulnerabilityResolved",
              "shortDescription": {
                "text": "A vulnerability was resolved"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "SBOM-TOOLS-007",
              "name": "SupplierChanged",
              "shortDescription": {
                "text": "A component supplier was changed"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "SBOM-EOL-001",
              "name": "ComponentEndOfLife",
              "shortDescription": {
                "text": "A component has reached end-of-life"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SBOM-EOL-002",
              "name": "ComponentApproachingEol",
              "shortDescription": {
                "text": "A component is approaching end-of-life"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
